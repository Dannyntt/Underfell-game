class Ui {
    // Todas las cadenas que se pasan a put() y say() se liberan aqui (evita fugas de heap).

    // Borra el interior de la caja (palabras 7..24, filas 100..180) sin tocar el borde
    function void clearBox() {
        do Screen.setColor(false);
        do Screen.drawRectangle(112, 100, 399, 180);
        do Screen.setColor(true);
        return;
    }

    // Texto instantaneo
    function void put(int row, int col, String s) {
        do Output.moveCursor(row, col);
        do Output.printString(s);
        do s.dispose();
        return;
    }

    // Texto con efecto maquina de escribir en (row, col)
    function void sayAt(int row, int col, String s) {
        var int i, n;
        do Output.moveCursor(row, col);
        let n = s.length();
        let i = 0;
        while (i < n) {
            do Output.printChar(s.charAt(i));
            do Sys.wait(18);
            let i = i + 1;
        }
        do s.dispose();
        return;
    }

    // Idem, dentro de la caja de combate (columna 15)
    function void say(int row, String s) {
        do Ui.sayAt(row, 15, s);
        return;
    }

    // Borra las filas de texto 21 y 22 (y=226..255), ancho completo
    function void clearText() {
        do Screen.setColor(false);
        do Screen.drawRectangle(0, 226, 511, 255);
        do Screen.setColor(true);
        return;
    }

    function void hpBar(int hp) {
        do Screen.setColor(false);
        do Screen.drawRectangle(216, 189, 277, 196);
        do Screen.setColor(true);
        if (hp > 0) {
            do Screen.drawRectangle(216, 189, 216 + (hp * 3) - 1, 196);
        }
        do Output.moveCursor(17, 35);
        do Output.printInt(hp);
        do Output.printChar(32);
        do Output.printChar(32);
        return;
    }

    // Barra de vida de Luzbel (arriba a la izquierda, 4 px por punto de vida)
    function void bossBar(int hp) {
        do Screen.setColor(false);
        do Screen.drawRectangle(32, 24, 152, 29);
        do Screen.setColor(true);
        if (hp > 0) {
            do Screen.drawRectangle(32, 24, 32 + (hp * 4) - 1, 29);
        }
        return;
    }

    function void turnLabel(int t) {
        do Ui.put(17, 48, "TURN ");
        do Output.printInt(t);
        return;
    }

    function void drawMenu() {
        do Ui.put(20, 6, "FIGHT");
        do Ui.put(20, 20, "ACT");
        do Ui.put(20, 34, "ITEM");
        do Ui.put(20, 48, "MERCY");
        return;
    }

