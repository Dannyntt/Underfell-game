    // Invierte los pixeles del sprite grande (parpadeo)
    function void flashBig() {
        var Array s;
        var int a, r, w;
        let s = 16525;
        let a = 0;
        let r = 0;
        while (r < 90) {
            let w = 0;
            while (w < 6) {
                let s[a + w] = ~s[a + w];
                let w = w + 1;
            }
            let a = a + 32;
            let r = r + 1;
        }
        return;
    }

    function void clearBossBig() {
        do Screen.setColor(false);
        do Screen.drawRectangle(208, 4, 303, 93);
        do Screen.setColor(true);
        return;
    }
