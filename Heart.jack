class Heart {
    field Array screen;   // apunta a 16384
    field Array frames;   // 16 desplazamientos x 8 filas x 2 palabras = 256
    field int col, shift; // palabra (0..30) y pixel dentro de la palabra (0..15)
    field int row;        // fila en pixeles
    field int addr;       // offset en pantalla: row*32 + col
    field int base;       // shift * 16: inicio de la version actual en frames
    field int x;          // posicion en pixeles (col*16 + shift)
    field int minX, maxX, minY, maxY;   // limites del movimiento

    constructor Heart new(int px, int py) {
        var int i, s, src, dst, lo, hi;

        let screen = 16384;
        let x = px;
        let col = px / 16;
        let shift = px & 15;
        let row = py;
        let addr = (py * 32) + col;
        let base = shift * 16;

        // limites por defecto: toda la pantalla
        let minX = 0;
        let maxX = 495;
        let minY = 0;
        let maxY = 248;

        let frames = Array.new(256);

        // Desplazamiento 0: palabra baja = sprite, palabra alta = 0
        let frames[0]  = 132;
        let frames[2]  = 330;
        let frames[4]  = 561;
        let frames[6]  = 645;
        let frames[8]  = 561;
        let frames[10] = 633;
        let frames[12] = 258;
        let frames[14] = 252;
        let i = 1;
        while (i < 16) {
            let frames[i] = 0;
            let i = i + 2;
        }

        // Desplazamientos 1..15: duplicar el bloque anterior (32 bits)
        let src = 0;
        let dst = 16;
        let s = 1;
        while (s < 16) {
            let i = 0;
            while (i < 16) {
                let lo = frames[src + i];
                let hi = frames[src + i + 1];
                let hi = hi + hi;
                if (lo < 0) { let hi = hi + 1; }   // acarreo del bit 15
                let frames[dst + i] = lo + lo;
                let frames[dst + i + 1] = hi;
                let i = i + 2;
            }
            let src = dst;
            let dst = dst + 16;
            let s = s + 1;
        }
        return this;
    }

    method void setLimits(int ax, int bx, int ay, int by) {
        let minX = ax;
        let maxX = bx;
        let minY = ay;
        let maxY = by;
        return;
    }

    // Coloca el corazon en otra posicion (no dibuja ni borra). Usa multiplicaciones: solo entre fases.
    method void moveTo(int px, int py) {
        let x = px;
        let col = px / 16;
        let shift = px & 15;
        let row = py;
        let addr = (py * 32) + col;
        let base = shift * 16;
        return;
    }

    // Borra las 2 palabras x 8 filas que ocupa el corazon
    method void erase() {
        var int a;
        let a = addr;
        let screen[a]       = 0;
        let screen[a + 1]   = 0;
        let screen[a + 32]  = 0;
        let screen[a + 33]  = 0;
        let screen[a + 64]  = 0;
        let screen[a + 65]  = 0;
        let screen[a + 96]  = 0;
        let screen[a + 97]  = 0;
        let screen[a + 128] = 0;
        let screen[a + 129] = 0;
        let screen[a + 160] = 0;
        let screen[a + 161] = 0;
        let screen[a + 192] = 0;
        let screen[a + 193] = 0;
        let screen[a + 224] = 0;
        let screen[a + 225] = 0;
        return;
    }

    method int getX() { return x; }
    method int getY() { return row; }

    method void dispose() {
        do frames.dispose();
        do Memory.deAlloc(this);
        return;
    }

    // Dibuja el corazon (reescribe 2 palabras por fila). Llamar una vez por cuadro.
    method void draw() {
        var int a, b;
        let a = addr;
        let b = base;
        let screen[a]       = frames[b];
        let screen[a + 1]   = frames[b + 1];
        let screen[a + 32]  = frames[b + 2];
        let screen[a + 33]  = frames[b + 3];
        let screen[a + 64]  = frames[b + 4];
        let screen[a + 65]  = frames[b + 5];
        let screen[a + 96]  = frames[b + 6];
        let screen[a + 97]  = frames[b + 7];
        let screen[a + 128] = frames[b + 8];
        let screen[a + 129] = frames[b + 9];
        let screen[a + 160] = frames[b + 10];
        let screen[a + 161] = frames[b + 11];
        let screen[a + 192] = frames[b + 12];
        let screen[a + 193] = frames[b + 13];
        let screen[a + 224] = frames[b + 14];
        let screen[a + 225] = frames[b + 15];
        return;
    }

    // Borra la palabra 'addr' en las 8 filas (solo al cruzar a la derecha)
    method void clearWord() {
        var int a;
        let a = addr;
        let screen[a]       = 0;
        let screen[a + 32]  = 0;
        let screen[a + 64]  = 0;
        let screen[a + 96]  = 0;
        let screen[a + 128] = 0;
        let screen[a + 160] = 0;
        let screen[a + 192] = 0;
        let screen[a + 224] = 0;
        return;
    }

    // Los move* solo actualizan estado y borran lo que queda vacio; el dibujo lo hace draw().
    method void moveRight() {
        if (x < maxX) {
            if (shift = 15) {
                do clearWord();
                let shift = 0;
                let col = col + 1;
                let addr = addr + 1;
                let base = 0;
            } else {
                let shift = shift + 1;
                let base = base + 16;
            }
            let x = x + 1;
        }
        return;
    }

    method void moveLeft() {
        if (x > minX) {
            if (shift = 0) {
                let shift = 15;
                let col = col - 1;
                let addr = addr - 1;
                let base = 240;
            } else {
                let shift = shift - 1;
                let base = base - 16;
            }
            let x = x - 1;
        }
        return;
    }

    method void moveUp() {
        if (row > minY) {
            let screen[addr + 224] = 0;   // fila que queda vacia
            let screen[addr + 225] = 0;
            let row = row - 1;
            let addr = addr - 32;
        }
        return;
    }

    method void moveDown() {
        if (row < maxY) {
            let screen[addr] = 0;         // fila que queda vacia
            let screen[addr + 1] = 0;
            let row = row + 1;
            let addr = addr + 32;
        }
        return;
    }
}
