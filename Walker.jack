        let sil[79] = 7;
        let sil[80] = 0;
        let sil[81] = -64;
        let sil[82] = 7;
        let sil[83] = 0;
        let sil[84] = -128;
        let sil[85] = 3;
        let sil[86] = 0;
        // desplazamientos 1..15: cada bloque es el anterior movido 1 px (96 bits en 3 palabras)
        let src = 0;
        let dst = 87;
        let s = 1;
        while (s < 16) {
            let i = 0;
            while (i < 87) {
                let lo = ink[src + i];
                let mid = ink[src + i + 1];
                let hi = ink[src + i + 2];
                let hi = hi + hi;
                if (mid < 0) { let hi = hi + 1; }
                let ink[dst + i + 2] = hi;
                let hi = mid + mid;
                if (lo < 0) { let hi = hi + 1; }
                let ink[dst + i + 1] = hi;
                let ink[dst + i] = lo + lo;

                let lo = sil[src + i];
                let mid = sil[src + i + 1];
                let hi = sil[src + i + 2];
                let hi = hi + hi;
                if (mid < 0) { let hi = hi + 1; }
                let sil[dst + i + 2] = hi;
                let hi = mid + mid;
                if (lo < 0) { let hi = hi + 1; }
                let sil[dst + i + 1] = hi;
                let sil[dst + i] = lo + lo;
                let i = i + 3;
            }
            let src = dst;
            let dst = dst + 87;
            let s = s + 1;
        }
        return this;
    }

    method int getX() { return x; }
    method int getY() { return y; }

    method void dispose() {
        do ink.dispose();
        do sil.dispose();
        do saved.dispose();
        do Memory.deAlloc(this);
        return;
    }

    // Los move* solo actualizan el estado; erase() antes y draw() despues
    method void moveRight() {
        if (shift = 15) {
            let shift = 0;
            let col = col + 1;
            let addr = addr + 1;
            let base = 0;
        } else {
            let shift = shift + 1;
            let base = base + 87;
        }
        let x = x + 1;
        return;
    }

    method void moveLeft() {
        if (shift = 0) {
            let shift = 15;
            let col = col - 1;
            let addr = addr - 1;
            let base = 1305;
        } else {
            let shift = shift - 1;
            let base = base - 87;
        }
        let x = x - 1;
        return;
    }

    method void moveUp() {
        let y = y - 1;
        let addr = addr - 32;
        return;
    }

    method void moveDown() {
        let y = y + 1;
        let addr = addr + 32;
        return;
    }

    method void draw() {
        var int a, b;
        let a = addr;
        let b = base;
        let saved[0] = screen[a];
