class Walker {
    // Personaje de la zona de exploracion: sprite 33x29 (3 palabras por fila) con 16 desplazamientos.
    // draw() guarda lo que hay debajo (saved) y dibuja silueta blanca + tinta; erase() lo restaura exacto.
    field Array screen, ink, sil, saved;
    field int x, y, col, shift, addr, base;

    constructor Walker new(int px, int py) {
        var int i, s, src, dst, lo, mid, hi;
        let screen = 16384;
        let x = px;
        let y = py;
        let col = px / 16;
        let shift = px & 15;
        let addr = (py * 32) + col;
        let base = shift * 87;

        let ink = Array.new(1392);
        let sil = Array.new(1392);
        let saved = Array.new(87);
